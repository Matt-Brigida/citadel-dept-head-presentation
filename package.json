{
  "name": "citadel-campus-presentation",
  "version": "1.0.0",
  "private": true,
  "description": "Matt Brigida's Department Head campus presentation for The Citadel",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "serve": "node scripts/serve.mjs",
    "pdf": "node scripts/export-pdf.mjs",
    "pdf:review": "node scripts/export-pdf.mjs --black-and-white dist/brigida-citadel-review.pdf",
    "pdf:notes": "node scripts/export-pdf.mjs --black-and-white --notes dist/brigida-citadel-notes.pdf",
    "pdf:all": "npm run -s pdf && npm run -s pdf -- brigida-citadel-presentation.pdf && npm run -s pdf:review && npm run -s pdf:notes",
    "vendor": "node scripts/vendor-reveal.mjs",
    "check": "node scripts/check-deck.mjs"
  },
  "devDependencies": {
    "reveal.js": "5.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
